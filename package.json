{
  "name": "milo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A source-preserving, self-editing, single-file research slide deck.",
  "bin": {
    "milo": "cli/milo.mjs"
  },
  "scripts": {
    "build": "node cli/milo.mjs content -o dist/milo.html --notices",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,css}\""
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.3",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "jsonc-parser": "3.3.1",
    "katex": "0.18.7",
    "markdown-it": "15.0.2",
    "parse5": "8.0.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "yakuhanjp": "4.1.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "prettier": "3.9.8"
  }
}
